{
  "name": "jmg-electric",
  "version": "3.3.0",
  "private": true,
  "description": "JMG - ELECTRIC: diseño y cálculo de instalaciones eléctricas interiores (CNE-Utilización, RNE EM.010, Norma DGE). Una plataforma de JMG Projects & Energy.",
  "scripts": {
    "local": "node herramientas/servidor-local.js",
    "test": "node herramientas/pruebas.js",
    "pruebas-ui": "node herramientas/pruebas-ui.mjs",
    "pruebas-planos": "node herramientas/pruebas-planos.js",
    "pruebas-excel": "node herramientas/pruebas-excel.mjs",
    "pruebas-dxf": "node herramientas/pruebas-dxf.js",
    "formato": "prettier --write \"js/**/*.js\" \"css/**/*.css\"",
    "revisar-formato": "prettier --check \"js/**/*.js\" \"css/**/*.css\"",
    "revisar": "node herramientas/revisar.js",
    "estilos-sin-uso": "node herramientas/estilos-sin-uso.js",
    "estilos-tapados": "node herramientas/estilos-tapados.js",
    "capturas": "node herramientas/capturas.mjs",
    "estres": "node herramientas/estres.mjs",
    "verificar": "npm run revisar && npm run revisar-formato && npm test && npm run pruebas-planos && npm run pruebas-dxf && npm run pruebas-excel && npm run pruebas-ui"
  },
  "devDependencies": {
    "eslint": "9.9.1",
    "globals": "15.9.0",
    "postcss": "8.4.41",
    "prettier": "3.3.3"
  }
}
